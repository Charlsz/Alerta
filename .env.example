# OPENROUTER_API_KEY: Requerida para el asistente IA y reportes PDF.
# Sin ella, el chat responde 503.
OPENROUTER_API_KEY=

# GFW_API_KEY: Requerida para descargar datos de deforestación de Global Forest Watch.
# Sin ella, colocar manualmente los archivos en data/raw/.
# Solicitar en: https://data-api.globalforestwatch.org/
GFW_API_KEY=

# SODA_APP_TOKEN: Opcional. Token de datos.gov.co para evitar rate limiting.
SODA_APP_TOKEN=

# API_PORT: Puerto para la API FastAPI (default: 8000)
API_PORT=8000

# NEXT_PUBLIC_API_URL: URL de la API para el frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
