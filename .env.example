# OPENROUTER_API_KEY: Para el asistente IA y reportes PDF.
# Sin ella, el mapa, ranking y fichas funcionan; el chat responde 503.
OPENROUTER_API_KEY=

# GFW_API_KEY: Para RE-DESCARGAR deforestación desde Global Forest Watch en Spaces/CI.
# Tras un clone los JSON ya vienen en data/raw/; la clave habilita updates "en vivo".
# Solicitar en: https://data-api.globalforestwatch.org/
GFW_API_KEY=

# SODA_APP_TOKEN: Opcional. Token de datos.gov.co para evitar rate limiting (pipeline completo).
SODA_APP_TOKEN=

# API_PORT: Puerto interno de FastAPI (default: 8000)
API_PORT=8000

# NEXT_PUBLIC_API_URL: URL de la API para el frontend Next.js (local: http://localhost:8000)
# En Docker/Spaces el rewrite usa 127.0.0.1:8000 dentro del contenedor.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Deploy / Hugging Face Spaces ------------------------------------------
# Ruta al DuckDB que sirve la API. Preferir la DB chica (~6MB):
ALERTA_DUCKDB_PATH=data/alerta_serving.duckdb

# Si el archivo no está en la imagen, descárgalo al arrancar (URL pública o HF resolve).
# Ejemplo: https://huggingface.co/datasets/USER/alerta-data/resolve/main/alerta_serving.duckdb
ALERTA_DUCKDB_URL=

# 1 = refrescar GFW en background. En Spaces (SPACE_ID) se activa solo si no se define.
ALERTA_LIVE_REFRESH=1

# Cada cuántas horas re-descargar GFW y reconstruir deforestación (default 168 = semanal).
# Hansen/GFW cambia ~anual; no baje de 24h en free tier.
ALERTA_GFW_REFRESH_HOURS=168
